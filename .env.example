# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LocalStack --------------------------------------------------------------
# Free-plan auth token from https://app.localstack.cloud — non-commercial use only.
LOCALSTACK_AUTH_TOKEN=ls-your-token-here

# --- LOCAL_ONLY guard --------------------------------------------------------
# Nothing may touch real AWS. These are dummy credentials on purpose.
LOCAL_ONLY=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=http://localhost:4566

# --- Ollama ------------------------------------------------------------------
# From the host. Lambda containers inside LocalStack use host.docker.internal instead.
OLLAMA_HOST=http://localhost:11434
PLANNER_MODEL=qwen3:4b
READER_MODEL=qwen3:1.7b
# llm | scripted  (scripted = the deterministic planner used for acceptance tests)
# Which planner drives a run, and what the console says it is.
#   scripted -- deterministic, a few seconds, the same tools and policies. Use this to
#               record: a small model drops a field often enough to spoil a take, and the
#               guarantee under test never depended on the planner.
#   llm      -- the real model. Slower and sometimes gives up on a field, which is a
#               utility outcome rather than a security one.
# The console shows whichever is active, so a recording cannot misrepresent it.
PLANNER_BACKEND=scripted

# --- Application -------------------------------------------------------------
STAGE=dev
TENANT_ID=kestrel
# Secret used to sign local demo JWTs, standing in for a hosted identity provider.
JWT_SIGNING_SECRET=change-me-for-local-dev-only
